{
  "name": "ai-visibility-audit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "integration",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test:scanner": "npm run test --workspace=@aiv/scanner",
    "test:scoring": "npm run test --workspace=@aiv/scoring",
    "test:ai-probe": "npm run test --workspace=@aiv/ai-probe",
    "test:integration": "npm run test --workspace=@aiv/integration",
    "test": "npm run test:scanner && npm run test:scoring && npm run test:ai-probe && npm run test:integration",
    "audit": "npm run build && tsx integration/scripts/audit.ts",
    "dev:web": "npm run dev --workspace=@aiv/web",
    "build:web": "npm run build --workspace=@aiv/web"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0"
  }
}
